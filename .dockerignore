# Docker build context exclusions
# Optimizes build performance and security

# Version control
.git/
.gitignore

# Dependencies (will be installed in container)
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (use Docker environment variables instead)
.env
.env.local
.env.development
.env.test
.env.production

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Test artifacts and reports (generated in container)
coverage/
reports/
test-results/
*.lcov
cucumber.json
cucumber.html

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Docker files (not needed in container)
Dockerfile*
compose*.yaml
compose*.yml
.dockerignore

# Documentation (not needed for runtime)
docs/
README.md
*.md

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml

# Security scanning results
snyk-results.json
audit-results.json

# Build artifacts
dist/
build/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port
