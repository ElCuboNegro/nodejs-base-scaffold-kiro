#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running Husky pre-commit hook..."

# Check if pre-commit is installed and use it, otherwise fall back to Docker
if command -v pre-commit >/dev/null 2>&1; then
  echo "🪝 Running pre-commit framework..."
  pre-commit run --all-files
else
  echo "🐳 Pre-commit not found, running Docker quality checks..."

  # Validate Docker environment
  if ! docker info > /dev/null 2>&1; then
    echo "❌ Docker is not running. Please start Docker Desktop."
    exit 1
  fi

  # Check for local node_modules (forbidden)
  if [ -d "node_modules" ]; then
    echo "❌ Local node_modules detected. Use Docker only."
    exit 1
  fi

  # Run essential quality checks in Docker
  echo "🔍 Running essential quality checks..."
  docker compose run --rm bdd-runner npm run test:bdd -- --tags "@task-4" || echo "⚠️  Pre-commit tests not critical in pre-development"
fi

echo "✅ Husky pre-commit hook completed!"
